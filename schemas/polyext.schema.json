{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://loogg.github.io/polyblock/schemas/polyext.schema.json",
  "title": "PolyBlock 扩展积木包规范 (.polyext.json)",
  "description": "PolyBlock 单轨声明式扩展包协议：一模块一扩展包，所有积木与侧边栏排布统一声明在 sections[] 中。",
  "type": "object",
  "required": ["format", "version", "id", "name", "sections"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "可选 JSON Schema 路径（指向 schemas/polyext.schema.json 以启用 VS Code 悬浮说明与自动补全）。"
    },
    "format": {
      "const": "polyblock-extension",
      "description": "固定格式标识：polyblock-extension。"
    },
    "version": {
      "const": 1,
      "description": "协议版本号，当前固定为 1。"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{2,48}$",
      "description": "扩展包唯一 ID（2~48 位字母、数字、横线或下划线）。全局导入不可覆盖预装包，但项目内嵌包可使用任意 ID（含 rt / virtual-board）在当前项目内无条件覆盖全局包。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "扩展包中文/英文展示名称（显示在扩展页与项目配置弹窗）。"
    },
    "packVersion": {
      "type": "string",
      "default": "1.0.0",
      "description": "扩展包自身语义版本号（默认 1.0.0）。"
    },
    "iconLabel": {
      "type": "string",
      "maxLength": 6,
      "description": "扩展卡片彩色图标上的短缩写（1~4 字，如 MCU / 硬件；省略时默认取首个 section 的 label）。"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "default": "#6366f1",
      "description": "扩展包主色（6 位 HEX，如 #0ea5e9）。"
    },
    "description": {
      "type": "string",
      "description": "扩展包功能简介。"
    },
    "builtin": {
      "type": "boolean",
      "description": "内部保留字段（用户导入包自动置为 false）。"
    },
    "tags": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "maxLength": 12 },
      "description": "可选自定义标签胶囊（最多 6 个，如 [\"CAN\", \"电机\"]）。"
    },
    "imports": {
      "$ref": "#/definitions/ExtensionPackImports",
      "description": "包级默认顶部导入语句（普通/表达式积木自动继承，并按内容全局去重；纯语法库不填）。"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/ExtensionSectionSpec" },
      "description": "组件列表（至少 1 项）：每项决定侧边栏归属、显隐、排序、可选句柄资源配置，并直接内嵌属于该组件的积木。多组件包自动支持按组件细粒度裁剪。"
    },
    "simWidgets": {
      "type": "array",
      "items": { "$ref": "#/definitions/SimWidgetSpec" },
      "description": "包内共享模拟控件资产表；仅在存在 sandboxMock 或非空 libs[] 时生效，并按已启用积木的 simWidgetKeys 自动按需加载。"
    },
    "sandboxMock": {
      "$ref": "#/definitions/ExtensionModuleSource",
      "description": "浏览器沙箱专用假桩实现（模拟真机 C 固件 API，如 board / i2c），真机 .zip 打包导出时严格剥离。单包内 moduleName 不可与 libs[] 重复。"
    },
    "libs": {
      "type": "array",
      "items": { "$ref": "#/definitions/ExtensionModuleSource" },
      "description": "真实纯脚本库源码列表（支持多文件入口库 + 辅助依赖表，如 crc16.lua + crc16_table.lua）：沙箱运行与真机 .zip 打包导出共用；单包内 moduleName 不可重复且不可与 sandboxMock 同名。"
    }
  },
  "definitions": {
    "ExtensionPackImports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lua": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Lua 5.4 文件顶层导入语句（如 [\"local mcu = require(\\\"mcu\\\")\"]）。"
        },
        "python": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Python 3 文件顶层导入语句（如 [\"import mcu\"]）。"
        }
      }
    },
    "ExtensionModuleSource": {
      "type": "object",
      "required": ["moduleName"],
      "additionalProperties": false,
      "properties": {
        "moduleName": {
          "type": "string",
          "minLength": 1,
          "description": "供 require(\"<moduleName>\") / import <moduleName> 加载的模块名（支持点号路径如 utils.crc16，导出时自动映射为 utils/crc16.lua）。"
        },
        "role": {
          "type": "string",
          "enum": ["entry", "helper"],
          "description": "可选角色标注：entry（入口库，暴露给积木调用）或 helper（辅助依赖表，如 crc16_table.lua）。"
        },
        "luaSource": {
          "type": "string",
          "description": "可选：Lua 5.4 模块源码（需 return M）。"
        },
        "pythonSource": {
          "type": "string",
          "description": "可选：Python 3 / MicroPython 模块源码。"
        }
      }
    },
    "HandleChannelPoolConfigSpec": {
      "type": "object",
      "required": ["kind", "label", "min", "max", "defaultCount"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "channel-pool",
          "description": "句柄资源配置类型：channel-pool 表示每句柄隔离的 0~N-1 编号通道池（自动联动抽屉配置按钮、别名面板与越界检查）。"
        },
        "configKey": {
          "type": "string",
          "description": "可选存储键覆盖；省略时自动派生为 <pack.id>.<section.id>（单组件包为 <pack.id>）。"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "资源名称（如 定时器通道 / PWM 舵机通道），用于抽屉顶部快捷按钮与句柄配置标题。"
        },
        "prefix": {
          "type": "string",
          "default": "CH",
          "description": "编号前缀（如 T -> T0、PWM -> PWM0；省略默认 CH）。"
        },
        "min": { "type": "integer", "minimum": 1, "maximum": 32 },
        "max": { "type": "integer", "minimum": 1, "maximum": 32 },
        "defaultCount": { "type": "integer", "minimum": 1, "maximum": 32 },
        "presets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 32 },
          "description": "可选快捷通道数预设按钮（如 [4, 8, 16]）。"
        },
        "hint": { "type": "string", "description": "句柄配置面板下方的补充说明文字。" }
      }
    },
    "ExtensionSectionSpec": {
      "type": "object",
      "required": ["id", "label", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,32}$",
          "description": "组件在包内的唯一 ID（如 lifecycle / timers / main）。"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "description": "组件名称（独立分类时作为侧边栏 Tab 名，多组件包同时用于勾选芯片显示）。"
        },
        "description": {
          "type": "string",
          "description": "可选组件功能描述（鼠标悬浮组件勾选芯片时展示）。"
        },
        "visible": {
          "type": "boolean",
          "default": true,
          "description": "是否在左侧工具箱显示该组件（默认 true）。"
        },
        "categoryTarget": {
          "type": "string",
          "enum": [
            "own",
            "event",
            "print",
            "control",
            "variables",
            "math",
            "logic",
            "text",
            "lists",
            "functions"
          ],
          "default": "own",
          "description": "侧边栏落位：'own' 新建独立分类（默认），或填任意 9 个核心分类 ID 将积木并入该核心分类。"
        },
        "toolboxOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999,
          "default": 100,
          "description": "独立分类时的排序序号（核心分类占 10~90：事件=10..函数=90；扩展默认 100+）。"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "可选组件独立主题色（省略时继承 pack.color）。"
        },
        "handleConfigs": {
          "type": "array",
          "items": { "$ref": "#/definitions/HandleChannelPoolConfigSpec" },
          "description": "可选每句柄资源配置声明（如 channel-pool 编号通道池）。"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/ExtensionBlockDef" },
          "description": "属于本组件的积木定义列表。"
        }
      }
    },
    "ExtensionCodeTemplate": {
      "type": "object",
      "required": ["template"],
      "additionalProperties": false,
      "properties": {
        "template": {
          "type": "string",
          "description": "代码模板，支持 {{ARG}}、{{ARG:json}}、{{ARG:int}}、{{ARG:bool_lua}}、{{ARG:bool_py}}、{{ARG:channel_comment_lua}}、{{ARG:channel_comment_py}}。"
        },
        "imports": {
          "type": "array",
          "items": { "type": "string" },
          "description": "可选覆盖包级默认 imports（传空数组 [] 可显式禁用默认导入）。"
        }
      }
    },
    "ExtensionHatSpec": {
      "type": "object",
      "required": ["eventName", "mode"],
      "additionalProperties": false,
      "properties": {
        "eventName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "生成的顶层回调函数名（如 on_run / on_timer / on_button / on_can_rx）。"
        },
        "params": {
          "type": "array",
          "items": { "type": "string" },
          "description": "回调形参列表（如 [\"key\", \"pressed\"]）。"
        },
        "mode": {
          "type": "string",
          "enum": ["singleton", "dispatch"],
          "description": "singleton：全句柄唯一顶层回调；dispatch：将多个帽块聚合成一个 if/elseif 路由函数。"
        },
        "imports": { "$ref": "#/definitions/ExtensionPackImports" },
        "conditionLua": { "type": "string", "description": "dispatch 模式下 Lua 分支条件模板。" },
        "conditionPython": { "type": "string", "description": "dispatch 模式下 Python 分支条件模板。" },
        "branchCommentLua": { "type": "string" },
        "branchCommentPython": { "type": "string" },
        "extractBranchFnPrefix": {
          "type": "string",
          "description": "可选方案 A 提取前缀（如 on_timer_），将各分支生成独立全局函数并由路由函数调用。"
        },
        "duplicateKeyTemplate": { "type": "string", "description": "用于静态检测重复分支的唯一键模板。" },
        "scopeLabelTemplate": { "type": "string" },
        "scopeShortTemplate": { "type": "string" },
        "scopeCategory": {
          "type": "string",
          "enum": ["lifecycle", "event", "function"],
          "default": "event"
        },
        "keepsAlive": {
          "type": "boolean",
          "default": true,
          "description": "声明该回调是否使沙箱事件循环保持常驻等待外部事件（默认 true）。"
        }
      }
    },
    "ExtensionBlockDef": {
      "type": "object",
      "required": ["type", "kind", "message0"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1, "description": "全局唯一积木类型 ID（建议 ext_<包名>_<动作>）。" },
        "kind": {
          "type": "string",
          "enum": ["statement", "value", "hat"],
          "description": "statement：语句动作块（含变量赋值）；value：带返回值表达式块；hat：顶层事件回调帽块。"
        },
        "message0": { "type": "string", "minLength": 1, "description": "积木展示文案，用 %1 / %2 对应 args0 各项。" },
        "args0": {
          "type": "array",
          "items": { "type": "object" },
          "description": "Blockly 参数定义（input_value / field_dropdown / field_number / field_input / field_variable / field_channel_id）。"
        },
        "inputsInline": { "type": "boolean", "default": true },
        "outputType": {
          "type": ["string", "null"],
          "description": "仅 kind='value' 时使用，限制返回类型（如 Number / String / Boolean 或 null 任意类型）。"
        },
        "tooltip": { "type": "string", "description": "鼠标悬浮积木时的提示说明。" },
        "keywords": { "type": "string", "description": "用于左侧搜索框检索的空格分隔关键词。" },
        "blockStyle": { "type": "string" },
        "fields": { "type": "object" },
        "shadows": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type", "value"],
            "properties": {
              "type": { "enum": ["math_number", "text"] },
              "value": { "type": ["number", "string"] }
            }
          }
        },
        "lua": { "$ref": "#/definitions/ExtensionCodeTemplate" },
        "python": { "$ref": "#/definitions/ExtensionCodeTemplate" },
        "hat": { "$ref": "#/definitions/ExtensionHatSpec" },
        "simWidgetKeys": {
          "type": "array",
          "items": { "type": "string" },
          "description": "关联 pack.simWidgets 中的控件 key；启用含此积木的 section 时自动加载对应模拟控件。"
        },
        "sandboxRunnable": {
          "type": "boolean",
          "default": true,
          "description": "默认 true；仅真机可用、浏览器沙箱无实现的积木标 false。"
        }
      }
    },
    "SimWidgetSpec": {
      "type": "object",
      "required": ["kind", "key", "label"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["led", "tricolor", "rgb", "bar", "screen", "slider", "toggle", "button"],
          "description": "模拟控件类型（所有控件关闭态均自动跟随明暗主题，无需配置熄灭色）。"
        },
        "key": { "type": "string", "minLength": 1, "description": "包内唯一状态键（加 global: 前缀可跨包共享）。" },
        "label": { "type": "string", "minLength": 1, "description": "控件中文标签名。" },
        "default": { "description": "初始默认值与复位值。" },
        "color": { "type": "string", "description": "可选亮态/强调色（如 #22c55e）。" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" },
        "unit": { "type": "string" },
        "maxLines": { "type": "integer", "minimum": 1, "maximum": 12 },
        "hint": { "type": "string" },
        "marks": { "type": "array", "items": { "type": "string" } },
        "activeLabel": { "type": "string" },
        "idleLabel": { "type": "string" },
        "emitEvent": {
          "type": "object",
          "required": ["eventName"],
          "properties": {
            "eventName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "args": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
            "trigger": { "enum": ["change", "rising"] }
          }
        }
      }
    }
  }
}
