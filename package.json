{
  "name": "polyblock",
  "version": "0.1.0",
  "private": true,
  "description": "PolyBlock - 多语言积木编程工作台（Blockly + MicroBlocks 视觉风格 + Lua / Python 纯前端 WASM 沙箱）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@blockly/block-plus-minus": "^13.5.0",
    "@micropython/micropython-webassembly-pyscript": "^1.29.0-6",
    "blockly": "^13.5.0",
    "lucide-react": "^1.79.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wasmoon": "^1.16.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^28.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
