                                                      }
                                                    }
                                                  },
                                                  "next": {
                                                    "block": {
                                                      "type": "poly_log",
                                                      "id": "vt_log_hi",
                                                      "fields": {
                                                        "LEVEL": "WARN"
                                                      },
                                                      "inputs": {
                                                        "MESSAGE": {
                                                          "block": {
                                                            "type": "text",
                                                            "id": "vt_warn_txt",
                                                            "fields": {
                                                              "TEXT": "高温告警！已点亮板载三色灯（红）"
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      },
                                      "ELSE": {
                                        "block": {
                                          "type": "ext_board_led",
                                          "id": "vt_led_ok",
                                          "fields": {
                                            "STATE": "false"
                                          },
                                          "next": {
                                            "block": {
                                              "type": "ext_board_rgb",
                                              "id": "vt_rgb_ok",
                                              "fields": {
                                                "COLOR": "#10b981"
                                              },
                                              "next": {
                                                "block": {
                                                  "type": "ext_board_oled",
                                                  "id": "vt_oled_ok",
                                                  "inputs": {
                                                    "TEXT": {
                                                      "block": {
                                                        "type": "text",
                                                        "id": "vt_ok_oled",
                                                        "fields": {
                                                          "TEXT": "TEMP NORMAL (OK)"
                                                        }
                                                      }
                                                    }
                                                  },
                                                  "next": {
                                                    "block": {
                                                      "type": "poly_log",
                                                      "id": "vt_log_ok",
                                                      "fields": {
                                                        "LEVEL": "OK"
                                                      },
                                                      "inputs": {
                                                        "MESSAGE": {
                                                          "block": {
                                                            "type": "text",
                                                            "id": "vt_ok_txt",
                                                            "fields": {
                                                              "TEXT": "温度正常，绿灯待机中"
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
