                                                }
                                              }
                                            }
                                          }
                                        }
                                      },
                                      "DO0": {
                                        "block": {
                                          "type": "ext_board_led",
                                          "id": "vt_led_hi",
                                          "fields": {
                                            "STATE": "true"
                                          },
                                          "next": {
                                            "block": {
                                              "type": "ext_board_rgb",
                                              "id": "vt_rgb_hi",
                                              "fields": {
                                                "COLOR": "#ef4444"
                                              },
                                              "next": {
                                                "block": {
                                                  "type": "ext_board_oled",
                                                  "id": "vt_oled_hi",
