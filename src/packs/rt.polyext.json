{
  "$schema": "../../schemas/polyext.schema.json",
  "format": "polyblock-extension",
  "version": 1,
  "id": "rt",
  "name": "嵌入式运行时核心包 (rt)",
  "packVersion": "1.0.0",
  "iconLabel": "运行",
  "color": "#6366f1",
  "description": "统一对应嵌入式 C 端 rt 模块：内含「周期事件」「多路定时 (0~31 通道池)」「系统时钟 (rt.tick)」3 个可裁剪组件，各自按声明配置独立决定侧边栏归属与排序。",
  "tags": [
    "RTOS 核心"
  ],
  "imports": {
    "lua": [
      "local rt = require(\"rt\")"
    ],
    "python": [
      "import rt"
    ]
  },
  "sections": [
    {
      "id": "lifecycle",
      "label": "周期事件",
      "description": "常驻周期回调 on_run（默认使能，可动态调频/启停）与安全停机 on_stop",
      "visible": true,
      "categoryTarget": "event",
      "color": "#e0911f",
      "runtimeMonitor": "scheduler",
      "blocks": [
        {
          "type": "poly_on_run",
          "kind": "hat",
          "message0": "当周期运行触发时",
          "inputsInline": true,
          "blockStyle": "event_blocks",
          "tooltip": "周期主回调（on_run，默认使能、每 100ms 触发一次；可在「当程序启动」或运行中用「设置周期运行间隔」调整频率）。",
          "keywords": "当周期运行 触发 on_run 周期 主循环 loop 回调 100ms",
          "hat": {
            "eventName": "on_run",
            "params": [],
            "mode": "singleton",
            "scopeLabelTemplate": "on_run (周期运行)",
            "scopeShortTemplate": "on_run",
            "scopeCategory": "lifecycle",
            "keepsAlive": false
          }
        },
        {
          "type": "poly_set_run_period",
          "kind": "statement",
          "message0": "设置周期运行间隔为 %1 ms",
          "args0": [
            {
              "type": "input_value",
              "name": "MS",
              "check": "Number"
            }
          ],
          "inputsInline": true,
          "blockStyle": "event_stmt_blocks",
          "shadows": {
            "MS": {
              "type": "math_number",
              "value": 100
            }
          },
          "tooltip": "设置或动态修改周期运行（on_run）的触发间隔（毫秒），调用后立即按新周期重新计时生效（对应 rt.set_run_period）。",
          "keywords": "设置 on_run 周期运行 间隔 period ms 频率",
          "code": {
            "lua": {
              "template": "rt.set_run_period({{MS}})"
            },
            "python": {
              "template": "rt.set_run_period({{MS}})"
            }
          }
        },
        {
          "type": "poly_run_control",
          "kind": "statement",
          "message0": "%1 周期运行",
          "args0": [
            {
              "type": "field_dropdown",
              "name": "ACTION",
              "options": [
                [
                  "启动",
                  "start_run"
                ],
                [
                  "停止",
                  "stop_run"
                ]
              ]
            }
          ],
          "inputsInline": true,
          "blockStyle": "event_stmt_blocks",
          "fields": {
            "ACTION": "stop_run"
          },
          "tooltip": "在运行时启动或暂停周期运行调度（默认使能为 1，对应 rt.start_run / rt.stop_run）。",
          "keywords": "启动 停止 暂停 on_run 周期运行 start_run stop_run",
          "code": {
            "lua": {
              "template": "rt.{{ACTION}}()"
            },
            "python": {
              "template": "rt.{{ACTION}}()"
            }
          }
        },
        {
          "type": "poly_on_stop",
          "kind": "hat",
          "message0": "当程序停止",
          "inputsInline": true,
          "blockStyle": "event_blocks",
          "tooltip": "手动停止常驻事件循环时自动执行一次收尾清理（生成顶层 on_stop 回调，如熄灭 LED / 复位输出）。",
          "keywords": "当程序停止 on_stop 退出 收尾 清理 事件",
          "hat": {
            "eventName": "on_stop",
            "params": [],
            "mode": "singleton",
            "scopeLabelTemplate": "on_stop (安全停机)",
            "scopeShortTemplate": "on_stop",
            "scopeCategory": "lifecycle",
            "keepsAlive": false
          }
        }
      ]
    },
    {
      "id": "timers",
      "label": "定时",
      "description": "每句柄独立整数通道定时器池（0~31 路）、画布就地别名与独立全局 on_timer_N 分发",
      "visible": true,
      "categoryTarget": "own",
      "toolboxOrder": 15,
      "color": "#6366f1",
      "runtimeMonitor": "timers",
      "handleConfigs": [
        {
          "kind": "channel-pool",
          "label": "定时器通道",
          "prefix": "T",
          "min": 1,
          "max": 32,
          "defaultCount": 8,
          "presets": [
            4,
            8,
            16,
            32
          ],
          "hint": "每个隔离句柄（独立 lua_State*）独享自己的定时器池与别名，彼此绝不窜扰；在画布上右键任意定时器积木也可就地修改别名。"
        }
      ],
      "blocks": [
        {
          "type": "poly_on_timer",
          "kind": "hat",
          "message0": "当定时器 %1 触发时",
          "args0": [
            {
              "type": "field_channel_id",
              "name": "TIMER_ID"
            }
          ],
          "inputsInline": true,
          "blockStyle": "timer_hat_blocks",
          "fields": {
            "TIMER_ID": "0"
          },
          "tooltip": "绑定指定通道 ID 的定时器到期回调：拆分为独立全局函数 on_timer_<id>()，并自动生成轻量 on_timer(id) 路由分发（零闭包）。",
          "keywords": "当定时器 触发 回调 on_timer timer id 通道",
          "hat": {
            "eventName": "on_timer",
            "params": [
              "id"
            ],
            "mode": "dispatch",
            "extractBranchFnPrefix": "on_timer_",
            "condition": {
              "lua": "id == {{TIMER_ID:int}}",
              "python": "id == {{TIMER_ID:int}}"
            },
            "branchComment": {
              "lua": "{{TIMER_ID:channel_comment}}",
              "python": "{{TIMER_ID:channel_comment}}"
            },
            "duplicateKeyTemplate": "{{TIMER_ID:int}}",
            "scopeLabelTemplate": "on_timer · {{TIMER_ID:channel_label}}",
            "scopeShortTemplate": "T{{TIMER_ID:int}}",
            "scopeCategory": "event",
            "keepsAlive": false
          }
        },
        {
          "type": "poly_start_timer",
          "kind": "statement",
          "message0": "启动定时器 %1 周期 %2 ms 重复 %3 次",
          "args0": [
            {
              "type": "field_channel_id",
              "name": "TIMER_ID"
            },
            {
              "type": "input_value",
              "name": "PERIOD_MS",
              "check": "Number"
            },
            {
              "type": "input_value",
              "name": "REPEAT",
              "check": "Number"
            }
          ],
          "inputsInline": true,
          "blockStyle": "timer_blocks",
          "fields": {
            "TIMER_ID": "0"
          },
          "shadows": {
            "PERIOD_MS": {
              "type": "math_number",
              "value": 500
            },
            "REPEAT": {
              "type": "math_number",
              "value": 0
            }
          },
          "tooltip": "启动或重置指定通道定时器（rt.start_timer(id, period_ms, repeat)）：repeat=0 持续循环，1 单次，N 触发 N 次后停止。",
          "keywords": "启动定时器 start_timer 周期 重复 循环 单次 timer",
          "code": {
            "lua": {
              "template": "rt.start_timer({{TIMER_ID:int}}, {{PERIOD_MS}}, {{REPEAT}}){{TIMER_ID:channel_comment}}"
            },
            "python": {
              "template": "rt.start_timer({{TIMER_ID:int}}, {{PERIOD_MS}}, {{REPEAT}}){{TIMER_ID:channel_comment}}"
            }
          }
        },
        {
          "type": "poly_stop_timer",
          "kind": "statement",
          "message0": "停止定时器 %1",
          "args0": [
            {
              "type": "field_channel_id",
              "name": "TIMER_ID"
            }
          ],
          "inputsInline": true,
          "blockStyle": "timer_blocks",
          "fields": {
            "TIMER_ID": "0"
          },
          "tooltip": "停止指定通道定时器（rt.stop_timer(id)）。",
          "keywords": "停止定时器 stop_timer 关闭 取消 timer",
          "code": {
            "lua": {
              "template": "rt.stop_timer({{TIMER_ID:int}}){{TIMER_ID:channel_comment}}"
            },
            "python": {
              "template": "rt.stop_timer({{TIMER_ID:int}}){{TIMER_ID:channel_comment}}"
            }
          }
        },
        {
          "type": "poly_get_timer_value",
          "kind": "value",
          "outputType": "Number",
          "message0": "定时器 %1 已过毫秒数",
          "args0": [
            {
              "type": "field_channel_id",
              "name": "TIMER_ID"
            }
          ],
          "inputsInline": true,
          "blockStyle": "timer_blocks",
          "fields": {
            "TIMER_ID": "0"
          },
          "tooltip": "读取指定定时器本周期已流逝的毫秒数（rt.get_timer_value(id)，0 → period_ms，未运行返回 0）。",
          "keywords": "读取 定时器 已过 毫秒 get_timer_value elapsed timer",
          "code": {
            "lua": {
              "template": "rt.get_timer_value({{TIMER_ID:int}})"
            },
            "python": {
              "template": "rt.get_timer_value({{TIMER_ID:int}})"
            }
          }
        },
        {
          "type": "poly_is_timer_running",
          "kind": "value",
          "outputType": "Boolean",
          "message0": "定时器 %1 正在运行?",
          "args0": [
            {
              "type": "field_channel_id",
              "name": "TIMER_ID"
            }
          ],
          "inputsInline": true,
          "blockStyle": "timer_blocks",
          "fields": {
            "TIMER_ID": "0"
          },
          "tooltip": "检查指定通道定时器当前是否处于运行状态（rt.is_timer_running(id)）。",
          "keywords": "定时器 正在运行 状态 is_timer_running running timer",
          "code": {
            "lua": {
              "template": "rt.is_timer_running({{TIMER_ID:int}})"
            },
            "python": {
              "template": "rt.is_timer_running({{TIMER_ID:int}})"
            }
          }
        }
      ]
    },
    {
      "id": "tick",
      "label": "时钟",
      "description": "嵌入式系统滴答 rt.tick、毫秒转 tick 与 32 位无符号回绕安全到期判断",
      "visible": true,
      "categoryTarget": "own",
      "toolboxOrder": 18,
      "color": "#0891b2",
      "blocks": [
        {
          "type": "poly_rt_tick",
          "kind": "value",
          "outputType": "Number",
          "message0": "获取系统 tick",
          "tooltip": "读取当前 32 位无符号系统滴答计数（对应 rt.tick()，沙箱默认 1000Hz 即 1ms/tick）。",
          "keywords": "系统 tick 时钟 滴答 毫秒 rt.tick get_tick uptime",
          "code": {
            "lua": {
              "template": "rt.tick()"
            },
            "python": {
              "template": "rt.tick()"
            }
          }
        },
        {
          "type": "poly_rt_ms_to_tick",
          "kind": "value",
          "outputType": "Number",
          "message0": "%1 ms 转为 tick",
          "args0": [
            {
              "type": "input_value",
              "name": "MS",
              "check": "Number"
            }
          ],
          "inputsInline": true,
          "shadows": {
            "MS": {
              "type": "math_number",
              "value": 500
            }
          },
          "tooltip": "将毫秒时长按目标板 tick 频率向上取整转换为 tick 数（对应 rt.ms_to_tick(ms)）。",
          "keywords": "毫秒 转换 tick ms_to_tick 时钟 滴答",
          "code": {
            "lua": {
              "template": "rt.ms_to_tick({{MS}})"
            },
            "python": {
              "template": "rt.ms_to_tick({{MS}})"
            }
          }
        },
        {
          "type": "poly_rt_is_expired",
          "kind": "value",
          "outputType": "Boolean",
          "message0": "从 %1 起经过 %2 tick 已到期?",
          "args0": [
            {
              "type": "input_value",
              "name": "START",
              "check": "Number"
            },
            {
              "type": "input_value",
              "name": "TIMEOUT",
              "check": "Number"
            }
          ],
          "inputsInline": true,
          "shadows": {
            "START": {
              "type": "math_number",
              "value": 0
            },
            "TIMEOUT": {
              "type": "math_number",
              "value": 500
            }
          },
          "tooltip": "32 位无符号回绕安全的到期判断（(uint32_t)(now - start) >= timeout），对应 rt.is_expired(start_tick, timeout_ticks)。",
          "keywords": "到期 超时 回绕 判断 is_expired tick timeout 时钟",
          "code": {
            "lua": {
              "template": "rt.is_expired({{START}}, {{TIMEOUT}})"
            },
            "python": {
              "template": "rt.is_expired({{START}}, {{TIMEOUT}})"
            }
          }
        }
      ]
    }
  ],
  "sandboxMock": {
    "moduleName": "rt",
    "sources": {
      "lua": "local M = {\n  set_run_period = __poly_rt_set_run_period,\n  start_run = __poly_rt_start_run,\n  stop_run = __poly_rt_stop_run,\n  start_timer = __poly_rt_start_timer,\n  stop_timer = __poly_rt_stop_timer,\n  get_timer_value = __poly_rt_get_timer_value,\n  is_timer_running = __poly_rt_is_timer_running,\n  tick = __poly_rt_tick,\n  ms_to_tick = __poly_rt_ms_to_tick,\n  is_expired = __poly_rt_is_expired,\n}\nreturn M",
      "python": "import _poly\n\ndef set_run_period(ms):\n    return _poly.rt_set_run_period(ms)\n\ndef start_run():\n    return _poly.rt_start_run()\n\ndef stop_run():\n    return _poly.rt_stop_run()\n\ndef start_timer(tid, period_ms, repeat=0):\n    return _poly.rt_start_timer(tid, period_ms, repeat)\n\ndef stop_timer(tid):\n    return _poly.rt_stop_timer(tid)\n\ndef get_timer_value(tid):\n    return _poly.rt_get_timer_value(tid)\n\ndef is_timer_running(tid):\n    return _poly.rt_is_timer_running(tid)\n\ndef tick():\n    return _poly.rt_tick()\n\ndef ms_to_tick(ms):\n    return _poly.rt_ms_to_tick(ms)\n\ndef is_expired(start_tick, timeout_ticks):\n    return _poly.rt_is_expired(start_tick, timeout_ticks)"
    }
  }
}
