    },
    {
      "kind": "button",
      "key": "btnB",
      "label": "按键 B",
      "default": false,
      "activeLabel": "按下中",
      "idleLabel": "释放",
      "emitEvent": {
        "eventName": "on_button",
        "args": [
          "B",
          "$value"
        ],
        "trigger": "change"
      }
    }
  ]
}
